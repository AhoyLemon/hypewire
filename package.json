{
  "name": "hypewire",
  "version": "1.0.0",
  "description": "AI hype headlines about the end of obscure things.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sass": "sass src/scss/site.scss:css/site.css --no-source-map --style=compressed",
    "build:pug": "bun scripts/build-pug.ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "bun run build:sass && bun run build:pug && bun run build:ts",
    "watch:sass": "sass src/scss/site.scss:css/site.css --no-source-map --watch",
    "watch:pug": "bun scripts/watch-pug.ts",
    "watch:ts": "tsc -p tsconfig.build.json --watch",
    "serve": "browser-sync start --config bs-config.cjs",
    "dev": "bun scripts/dev.ts",
    "sample": "bun scripts/sample.ts",
    "post:bluesky": "bun scripts/post.ts",
    "test:sass": "sass src/scss/site.scss --no-source-map --style=compressed > /dev/null",
    "test:ts": "tsc --noEmit",
    "test:unit": "bun test tests",
    "test": "bun run test:sass && bun run test:ts && bun run test:unit",
    "clean": "rimraf css js/min"
  },
  "author": "Lemon",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^20.10.0",
    "browser-sync": "^3.0.2",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "ora": "^8.0.1",
    "pug": "^3.0.2",
    "rimraf": "^5.0.5",
    "sass": "^1.69.5",
    "typescript": "^5.3.3",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "@atproto/api": "^0.29.4"
  }
}

.javascripts
  if testing
    script(src="https://unpkg.com/vue@3/dist/vue.global.js")
    script.
      const testing = true;
  else
    script(src="https://unpkg.com/vue@3/dist/vue.global.prod.js")
    script.
      const testing = false;

  //- Satori and the card fonts, pinned to the installed versions by scripts/_pugLocals.ts. It has to come before any module script.
  script(type="importmap")!= importMap

  script(type="module" src="js/min/site.js?updated="+lastUpdated)
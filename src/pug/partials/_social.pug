//- OpenGraph needs absolute URLs, so these always point at the published site.
meta(property="og:title" content=siteTitle)
meta(property="og:type" content="website")
meta(property="og:description" content=description)
meta(property="og:url" content=liveURL + "/")
meta(property="og:image" content=liveURL + "/img/og-wide.png")
meta(property="og:image:width" content="1280")
meta(property="og:image:height" content="640")
meta(property="og:image:alt" content=siteTitle + ": " + description)
meta(name="twitter:card" content="summary_large_image")
